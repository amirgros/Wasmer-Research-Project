diff --git a/lib/vm/src/perf_trace.rs b/lib/vm/src/perf_trace.rs
new file mode 100644
index 00000000000..16ecd38d44c
--- /dev/null
+++ b/lib/vm/src/perf_trace.rs
@@ -0,0 +1,100 @@
+//! Lock-free perf trace buffer — zero print overhead during measurement.
+//! In Rust:  [`perf_record`]`("label", begin_cycles, end_cycles)`
+//! From C:   `wasmer_perf_dump()`  — print all recorded entries and reset
+//!           `wasmer_perf_reset()` — discard all entries without printing
+
+use std::cell::RefCell;
+use std::sync::OnceLock;
+
+/// A single begin/end cycle-count measurement recorded by [`perf_record`].
+pub struct PerfEntry {
+    /// Static label identifying this measurement point.
+    pub label: &'static str,
+    /// TSC value at the start of the measured section.
+    pub begin: u64,
+    /// TSC value at the end of the measured section.
+    pub end: u64,
+}
+
+thread_local! {
+    static PERF_BUFFER: RefCell<Vec<PerfEntry>> = {
+        let mut v = Vec::new();
+        v.reserve(512);
+        RefCell::new(v)
+    };
+}
+
+/// Read the x86-64 TSC counter (non-serializing `rdtsc`).
+#[cfg(target_arch = "x86_64")]
+#[inline(always)]
+pub fn get_cycles() -> u64 {
+    let (lo, hi): (u32, u32);
+    unsafe {
+        std::arch::asm!("rdtsc", out("eax") lo, out("edx") hi, options(nostack, nomem));
+    }
+    ((hi as u64) << 32) | lo as u64
+}
+
+/// Record a begin/end cycle pair into the thread-local buffer.
+/// Cost: TLS access + Vec::push — no syscall, no allocation (if pre-reserved).
+#[inline(always)]
+pub fn perf_record(label: &'static str, begin: u64, end: u64) {
+    PERF_BUFFER.with(|buf| {
+        buf.borrow_mut().push(PerfEntry { label, begin, end });
+    });
+}
+
+// ── TSC frequency calibration ────────────────────────────────────────────────
+
+fn monotonic_ns() -> u64 {
+    let mut ts = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut ts); }
+    ts.tv_sec as u64 * 1_000_000_000 + ts.tv_nsec as u64
+}
+
+/// Returns TSC ticks per nanosecond (= GHz), calibrated once against CLOCK_MONOTONIC.
+/// Spins for ~5 ms on the first call; subsequent calls are free.
+pub fn tsc_freq_ghz() -> f64 {
+    static TSC_GHZ: OnceLock<f64> = OnceLock::new();
+    *TSC_GHZ.get_or_init(|| {
+        let t0_ns = monotonic_ns();
+        let t0_tsc = get_cycles();
+        let target_ns = t0_ns + 5_000_000; // spin 5 ms
+        loop {
+            let now_ns = monotonic_ns();
+            if now_ns >= target_ns {
+                let dt_tsc = get_cycles().wrapping_sub(t0_tsc);
+                let dt_ns = now_ns - t0_ns;
+                return dt_tsc as f64 / dt_ns as f64;
+            }
+        }
+    })
+}
+
+// ── Dump / reset ─────────────────────────────────────────────────────────────
+
+fn do_dump() {
+    let freq_ghz = tsc_freq_ghz();
+    let entries: Vec<PerfEntry> = PERF_BUFFER.with(|buf| std::mem::take(&mut *buf.borrow_mut()));
+    for e in &entries {
+        let d = e.end.wrapping_sub(e.begin);
+        let us = d as f64 / (freq_ghz * 1e3);
+        let msg = format!(
+            "[PERF] {:<32} begin={:>20}  end={:>20}  delta={:>10} cyc  ({:.3} us)\n",
+            e.label, e.begin, e.end, d, us
+        );
+        unsafe { libc::write(1, msg.as_ptr() as *const libc::c_void, msg.len()); }
+    }
+}
+
+/// Print all buffered perf entries (with auto-calibrated TSC frequency) then clear.
+#[unsafe(no_mangle)]
+pub extern "C" fn wasmer_perf_dump() {
+    do_dump();
+}
+
+/// Discard all buffered entries without printing.
+#[unsafe(no_mangle)]
+pub extern "C" fn wasmer_perf_reset() {
+    PERF_BUFFER.with(|buf| buf.borrow_mut().clear());
+}
